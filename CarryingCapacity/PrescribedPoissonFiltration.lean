import CarryingCapacity.PrescribedPoissonRealization
import CarryingCapacity.InitialMarkedPastIndependence
import CarryingCapacity.UsualFiltration

/-!
# Causality of the supplied-PRM realization

The source filtration is generated by the whole initial record and the
supplied measures restricted in time. Past-only reconstruction proves that
the decoded canonical record is measurable into its raw history after null
augmentation, and into its usual history after the usual augmentation.
No process-generated sigma algebra or future-noise information is introduced.
-/

noncomputable section
open MeasureTheory ProbabilityTheory MeasurableSpace Set Filter
open scoped Classical

namespace CarryingCapacity.PrescribedPoissonFiltration
open MarkedPastReconstruction PrescribedPoissonRealization

variable {Ω A : Type*} [mΩ : MeasurableSpace Ω] [MeasurableSpace A]
  (J : Type) [Fintype J] (M : J → Ω → Measure (ℝ × ℝ)) (ξ : Ω → A)

def history (t : ℝ) (ω : Ω) : A × (J → Measure (ℝ × ℝ)) :=
  (ξ ω, pastMeasures t (fun j => M j ω))

def rawAt (t : ℝ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (history J M ξ t) inferInstance

omit mΩ [Fintype J] in
theorem measurable_history_at (t : ℝ) : Measurable[rawAt J M ξ t] (history J M ξ t) :=
  comap_measurable _

omit [Fintype J] in
theorem measurable_history (hM : ∀ j, Measurable (M j)) (hξ : Measurable ξ) (t : ℝ) :
    Measurable (history J M ξ t) :=
  hξ.prodMk ((measurable_pastMeasures t).comp (measurable_pi_lambda _ hM))

omit [Fintype J] in
theorem pastMeasures_pastMeasures {s t : ℝ} (hst : s ≤ t) (K : J → Measure (ℝ × ℝ)) :
    pastMeasures s (pastMeasures t K) = pastMeasures s K := by
  funext j
  rw [pastMeasures, pastMeasures, Measure.restrict_restrict (measurableSet_pastSet s)]
  congr 1
  apply inter_eq_left.mpr
  intro x hx
  exact ⟨hx.1.trans hst,hx.2⟩

omit mΩ [Fintype J] in
theorem rawAt_mono : Monotone (rawAt J M ξ) := by
  intro s t hst
  have he : history J M ξ s =
      (fun p : A × (J → Measure (ℝ × ℝ)) => (p.1,pastMeasures s p.2)) ∘ history J M ξ t := by
    funext ω
    exact congrArg (Prod.mk (ξ ω)) (pastMeasures_pastMeasures J hst _).symm
  change MeasurableSpace.comap (history J M ξ s) _ ≤ _
  rw [he, ← MeasurableSpace.comap_comp]
  exact MeasurableSpace.comap_mono
    (measurable_fst.prodMk ((measurable_pastMeasures s).comp measurable_snd)).comap_le

/-- The raw natural filtration of the original initial data and supplied measures. -/
def rawFiltration (hM : ∀ j, Measurable (M j)) (hξ : Measurable ξ) : Filtration ℝ mΩ where
  seq := rawAt J M ξ
  mono' := rawAt_mono J M ξ
  le' t := (measurable_history J M ξ hM hξ t).comap_le

variable (P : Measure Ω) [IsProbabilityMeasure P]
  (hM : ∀ j, Measurable (M j))
  (hPoisson : PoissonObservationLaw.HasDisjointLaws P J M)
include hM hPoisson

/-- The actual decoded history agrees with a function of supplied past counts. -/
theorem ae_view_noise (t : ℝ) : ∀ᵐ ω ∂P,
    CommonNoiseFiltration.view t (noise J M ω) =
      MarkedPastReconstruction.decode J t
        (MarkedNoiseObservation.observeMeasures J (pastMeasures t (fun j => M j ω))) := by
  have h := ae_decode_observePast J t
  rw [← noise_map J M P hM hPoisson] at h
  have hh := ae_of_ae_map (measurable_noise J M hM).aemeasurable h
  filter_upwards [hh,ae_countingMeasure_noise J M P hM hPoisson] with ω hω hc
  have he : (fun j => MarkedNoise.countingMeasure j (noise J M ω)) = (fun j => M j ω) := funext hc
  rw [observePast,he] at hω
  exact hω.symm

theorem measurable_view_noise_completedAt (t : ℝ) :
    Measurable[NullAugmentedIndependence.augmentation (rawAt J M ξ t) P]
      (fun ω => CommonNoiseFiltration.view t (noise J M ω)) := by
  have hm : Measurable[rawAt J M ξ t]
      (fun ω => MarkedPastReconstruction.decode J t
        (MarkedNoiseObservation.observeMeasures J (pastMeasures t (fun j => M j ω)))) :=
    (MarkedPastReconstruction.measurable_decode J t).comp
      ((MarkedNoiseObservation.measurable_observeMeasures J).comp
        (measurable_history_at J M ξ t).snd)
  intro S hS
  refine ⟨_,hm hS,?_⟩
  filter_upwards [ae_view_noise J M P hM hPoisson t] with ω hω
  change (CommonNoiseFiltration.view t (noise J M ω) ∈ S) = _
  rw [hω]
  rfl

/-- Causal reconstruction maps completed supplied histories into the canonical
raw history, retaining the original initial record. -/
theorem measurable_record_completedAt (t : ℝ) :
    @Measurable Ω (CommonInitialNoise.Sample A J)
      (NullAugmentedIndependence.augmentation (rawAt J M ξ t) P)
      (CommonInitialNoise.filtration A J t) (record J M ξ) := by
  have hi : Measurable[NullAugmentedIndependence.augmentation (rawAt J M ξ t) P] ξ :=
    (measurable_history_at J M ξ t).fst.mono
      (NullAugmentedIndependence.le_augmentation _ P) le_rfl
  have hn : @Measurable Ω (MarkedNoise.Sample J)
      (NullAugmentedIndependence.augmentation (rawAt J M ξ t) P)
      (CommonNoiseFiltration.filtration J t) (noise J M) := by
    apply Measurable.of_comap_le
    change MeasurableSpace.comap (noise J M)
      (MeasurableSpace.comap (CommonNoiseFiltration.view t) inferInstance) ≤ _
    rw [MeasurableSpace.comap_comp]
    exact (measurable_view_noise_completedAt J M ξ P hM hPoisson t).comap_le
  exact hi.prodMk hn

variable (hξ : Measurable ξ)
  (hIndependent : IndepFun ξ (fun ω => fun j => M j ω) P)
include hξ hIndependent

theorem measurable_record_completedHistories (t : ℝ) :
    @Measurable Ω (CommonInitialNoise.Sample A J)
      (UsualFiltration.completedAt P (rawFiltration J M ξ hM hξ) t)
      (UsualFiltration.completedAt (CommonInitialNoise.law (P.map ξ) J)
        (CommonInitialNoise.filtration A J) t) (record J M ξ) := by
  rintro S ⟨B,hB,hSB⟩
  obtain ⟨C,hC,hBC⟩ := measurable_record_completedAt J M ξ P hM hPoisson t hB
  refine ⟨C,hC,?_⟩
  have he : (record J M ξ ⁻¹' S) =ᵐ[P] (record J M ξ ⁻¹' B) :=
    PrescribedPoissonRealization.ae_record J M ξ P hM hPoisson hξ hIndependent
      (Q := fun p => S p = B p) hSB
  exact Filter.EventuallyEq.trans he hBC

/-- The supplied realization is causal for the completed right-continuous
natural filtrations on both spaces. -/
theorem measurable_record_usualAt (t : ℝ) :
    @Measurable Ω (CommonInitialNoise.Sample A J)
      (UsualFiltration.usualAt P (rawFiltration J M ξ hM hξ) t)
      (UsualFiltration.usualAt (CommonInitialNoise.law (P.map ξ) J)
        (CommonInitialNoise.filtration A J) t) (record J M ξ) := by
  intro S hS
  apply (UsualFiltration.measurableSet_at_iff _ _ _ _).mpr
  intro u hu
  exact measurable_record_completedHistories J M ξ P hM hPoisson hξ hIndependent u
    ((UsualFiltration.measurableSet_at_iff _ _ _ _).mp hS u hu)

/-- Every raw-adapted canonical process has a genuine adapted realization in
the usual supplied initial/counting-measure filtration. -/
theorem measurable_realized_at {E : Type*} [MeasurableSpace E]
    (X : CommonInitialNoise.Sample A J → ℝ → E) (t : ℝ)
    (hX : Measurable[CommonInitialNoise.filtration A J t] (fun p => X p t)) :
    Measurable[UsualFiltration.usualAt P (rawFiltration J M ξ hM hξ) t]
      (fun ω => X (record J M ξ ω) t) := by
  exact (hX.mono (UsualFiltration.raw_le_usualAt _ _ t) le_rfl).comp
    (measurable_record_usualAt J M ξ P hM hPoisson hξ hIndependent t)

end CarryingCapacity.PrescribedPoissonFiltration
