import CarryingCapacity.CommonInitialNoise

/-!
# First-exit stopping times with an independent arbitrary initial law

The actual initial-record/noise product filtration is augmented by null sets
of its actual product law. Its finite-time sigma algebras are exactly the sets
almost everywhere equal to raw initial-plus-history events; minimality of this
augmentation is proved. At infinity we use the supremum of finite histories.

The exact first exit of the actual randomly initialized frozen process is a
stopping time here. Exceptional samples are handled by completion, not by an
unjustified transfer of almost-sure regularity to raw measurability. No right
continuity, compensator, or optional-stopping identity is asserted.
-/

noncomputable section
open MeasureTheory Set Filter TopologicalSpace
open scoped Classical ENNReal NNReal

namespace CarryingCapacity.CommonInitialStopping
open CommonInitialNoise

variable {A : Type*} [MeasurableSpace A]

/-- Completion of the actual initial-record/noise product sample space. -/
def completedSpace (μ : Measure A) (J : Type*) : MeasurableSpace (Sample A J) :=
  EventuallyMeasurableSpace inferInstance (ae (law μ J))

/-- The actual product law extended to its completed ambient sigma algebra. -/
def completedLaw (μ : Measure A) (J : Type*) : @Measure (Sample A J) (completedSpace μ J) :=
  (law μ J).completion

@[simp] theorem completedLaw_apply (μ : Measure A) (J : Type*) (s : Set (Sample A J)) :
    completedLaw μ J s = law μ J s := rfl

@[simp] theorem ae_completedLaw (μ : Measure A) (J : Type*) :
    ae (completedLaw μ J) = ae (law μ J) := rfl

instance completedLaw_probability (μ : Measure A) [IsProbabilityMeasure μ] (J : Type*) :
    IsProbabilityMeasure (completedLaw μ J) :=
  ⟨by change law μ J univ = 1; exact measure_univ⟩

instance completedLaw_complete (μ : Measure A) (J : Type*) :
    (completedLaw μ J).IsComplete := inferInstanceAs ((law μ J).completion.IsComplete)

/-- A product history enlarged only by ambient-product null sets. -/
def completedAt (μ : Measure A) (J : Type*) (t : ℝ) : MeasurableSpace (Sample A J) :=
  EventuallyMeasurableSpace (filtration A J t) (ae (law μ J))

theorem measurableSet_completedAt_iff (μ : Measure A) (J : Type*)
    (t : ℝ) (s : Set (Sample A J)) : MeasurableSet[completedAt μ J t] s ↔
      ∃ r, MeasurableSet[filtration A J t] r ∧ s =ᵐ[law μ J] r := Iff.rfl

theorem raw_le_completedAt (μ : Measure A) (J : Type*) (t : ℝ) :
    filtration A J t ≤ completedAt μ J t := EventuallyMeasurableSpace.measurable_le

/-- All subsets of ambient null events are present from time zero onward. -/
theorem measurableSet_completedAt_of_null (μ : Measure A) (J : Type*) (t : ℝ)
    {s : Set (Sample A J)} (hs : law μ J s = 0) : MeasurableSet[completedAt μ J t] s := by
  apply (measurableSet_completedAt_iff μ J t s).mpr
  refine ⟨∅, ?_, ?_⟩
  · exact @MeasurableSet.empty _ (filtration A J t)
  · exact ae_eq_empty.mpr hs

/-- This is the smallest sigma algebra containing the raw product history and
all ambient null sets. Future information is not added by any other rule. -/
theorem completedAt_le_of_null_sets (μ : Measure A) (J : Type*) (t : ℝ)
    (m : MeasurableSpace (Sample A J)) (hraw : filtration A J t ≤ m)
    (hnull : ∀ s, law μ J s = 0 → MeasurableSet[m] s) : completedAt μ J t ≤ m := by
  intro s hs
  obtain ⟨r, hr, heq⟩ := hs
  have hsr := hnull (s \ r) (ae_le_set.mp heq.le)
  have hrs := hnull (r \ s) (ae_le_set.mp heq.symm.le)
  have hid : s = (r \ (r \ s)) ∪ (s \ r) := by
    ext x
    simp only [mem_union, mem_diff]
    tauto
  rw [hid]
  exact ((hraw r hr).diff hrs).union hsr

theorem completedAt_mono (μ : Measure A) (J : Type*) : Monotone (completedAt μ J) := by
  intro s t hst a ha
  obtain ⟨r, hr, heq⟩ := ha
  exact ⟨r, (filtration A J).mono hst r hr, heq⟩

theorem completedAt_le_completedSpace (μ : Measure A) (J : Type*) (t : ℝ) :
    completedAt μ J t ≤ completedSpace μ J := by
  intro s hs
  obtain ⟨r, hr, heq⟩ := hs
  exact ⟨r, (filtration A J).le t r hr, heq⟩

/-- The completed initial-plus-noise filtration at real times. -/
def completedFiltration (μ : Measure A) (J : Type*) : Filtration ℝ (completedSpace μ J) where
  seq := completedAt μ J
  mono' := completedAt_mono μ J
  le' := completedAt_le_completedSpace μ J

/-- The sigma algebra generated by all completed nonnegative finite histories. -/
def terminalHistory (μ : Measure A) (J : Type*) : MeasurableSpace (Sample A J) :=
  ⨆ t : ℝ≥0, completedAt μ J (t : ℝ)

theorem terminalHistory_le_completedSpace (μ : Measure A) (J : Type*) :
    terminalHistory μ J ≤ completedSpace μ J :=
  iSup_le (fun t => completedAt_le_completedSpace μ J t)

/-- The extended-time product filtration. Its infinite-time component is the
supremum of finite histories, not an arbitrary full ambient sigma algebra. -/
def extendedFiltration (μ : Measure A) (J : Type*) : Filtration ℝ≥0∞ (completedSpace μ J) where
  seq t := if t = ⊤ then terminalHistory μ J else completedAt μ J t.toReal
  mono' := by
    intro s t hst
    by_cases ht : t = ⊤
    · simp only [ht, ↓reduceIte]
      split_ifs with hs
      · exact le_rfl
      · exact le_iSup (fun u : ℝ≥0 => completedAt μ J (u : ℝ))
          (⟨s.toReal, ENNReal.toReal_nonneg⟩ : ℝ≥0)
    · have hs : s ≠ ⊤ := ne_top_of_le_ne_top ht hst
      simp only [ht, hs, ↓reduceIte]
      exact completedAt_mono μ J (ENNReal.toReal_mono ht hst)
  le' t := by
    split_ifs
    · exact terminalHistory_le_completedSpace μ J
    · exact completedAt_le_completedSpace μ J t.toReal

@[simp] theorem extendedFiltration_top (μ : Measure A) (J : Type*) :
    extendedFiltration μ J ⊤ = terminalHistory μ J := by simp [extendedFiltration]

theorem extendedFiltration_of_ne_top (μ : Measure A) (J : Type*)
    {t : ℝ≥0∞} (ht : t ≠ ⊤) :
    extendedFiltration μ J t = completedAt μ J t.toReal := by simp [extendedFiltration, ht]

/-- Completion retains measurability of the whole original initial record. -/
theorem measurable_initial_at_completed (μ : Measure A) (J : Type*) (t : ℝ) :
    Measurable[completedAt μ J t] (Prod.fst : Sample A J → A) :=
  (measurable_initial_at t).mono (raw_le_completedAt μ J t) le_rfl

section Exits

variable {E J : Type*} [DecidableEq E] [Fintype J]
  (μ : Measure A) (active : Finset E) (jump : J → E → E) (rate : J → E → ℝ)
  (initial : A → E)

/-- On the actual product sample space, the true first-exit event is almost
surely the event that the actual frozen state is outside at the specified time. -/
theorem ae_firstExit_le_iff_outside : ∀ᵐ p ∂law μ J, ∀ C t, 0 ≤ t →
    (firstExit active jump rate initial C p ≤ ENNReal.ofReal t ↔
      process active jump rate initial C p t ∉ active) := by
  filter_upwards [ae_noise μ
    (CommonFrozenStopping.ae_firstExit_le_iff_outside active jump rate)] with p hp
  exact fun C t ht => hp C (initial p.1) t ht

variable [Countable E] [MeasurableSpace E] [MeasurableSingletonClass E]
  (hinit : Measurable initial)
include hinit

/-- Actual initialized state evaluations remain history-measurable after the
minimal null augmentation. -/
theorem measurable_process_at_completed (C t : ℝ) :
    Measurable[completedAt μ J t] (fun p => process active jump rate initial C p t) :=
  (measurable_process_at active jump rate initial hinit C t).mono
    (raw_le_completedAt μ J t) le_rfl

/-- Actual first-exit sublevels belong to the appropriate completed product
history, including their potentially nonmeasurable exceptional samples. -/
theorem measurableSet_firstExit_le (C : ℝ) {t : ℝ} (ht : 0 ≤ t) :
    MeasurableSet[completedAt μ J t]
      {p | firstExit active jump rate initial C p ≤ ENNReal.ofReal t} := by
  refine ⟨{p | process active jump rate initial C p t ∉ active}, ?_, ?_⟩
  · exact active.measurableSet.compl.preimage
      (measurable_process_at active jump rate initial hinit C t)
  · filter_upwards [ae_firstExit_le_iff_outside μ active jump rate initial] with p hp
    exact propext (hp C t ht)

/-- The exact first exit of the actual independently initialized frozen path
is a stopping time. No modification of the exit functional is used. -/
theorem isStoppingTime_firstExit (C : ℝ) :
    IsStoppingTime (extendedFiltration μ J) (firstExit active jump rate initial C) := by
  intro t
  by_cases ht : t = ⊤
  · simp only [ht, le_top, setOf_true]
    exact MeasurableSet.univ
  · rw [extendedFiltration_of_ne_top μ J ht]
    simpa only [ENNReal.ofReal_toReal ht] using
      (measurableSet_firstExit_le μ active jump rate initial hinit C
        (t := t.toReal) ENNReal.toReal_nonneg)

/-- The first exit is genuinely measurable in the completed product space. -/
theorem measurable_firstExit (C : ℝ) :
    Measurable[completedSpace μ J] (firstExit active jump rate initial C) :=
  ((isStoppingTime_firstExit μ active jump rate initial hinit C).measurable_of_le
    (fun _ => le_top)).mono ((extendedFiltration μ J).le ⊤) le_rfl

/-- On the original product probability space, the exact first exit is
almost-everywhere measurable, without asserting raw measurable versions coincide everywhere. -/
theorem aemeasurable_firstExit (C : ℝ) :
    AEMeasurable (firstExit active jump rate initial C) (law μ J) :=
  (show NullMeasurable (firstExit active jump rate initial C) (law μ J) from
    measurable_firstExit μ active jump rate initial hinit C).aemeasurable

/-- By a fixed time one can measure the first exit truncated at that time. -/
theorem measurable_truncated_firstExit (C : ℝ) (t : ℝ≥0∞) :
    Measurable[extendedFiltration μ J t]
      (fun p => min (firstExit active jump rate initial C p) t) :=
  ((isStoppingTime_firstExit μ active jump rate initial hinit C).min_const t).measurable_of_le
    (fun _ => min_le_right _ _)

/-- The same actual paths are adapted to the completed product histories. -/
theorem adapted_process_completed [TopologicalSpace E] [PseudoMetrizableSpace E]
    [SecondCountableTopology E] [OpensMeasurableSpace E] (C : ℝ) :
    Adapted (completedFiltration μ J) (fun t p => process active jump rate initial C p t) :=
  fun t => (measurable_process_at_completed μ active jump rate initial hinit C t).stronglyMeasurable

end Exits

end CarryingCapacity.CommonInitialStopping
