import CarryingCapacity.CommonNoiseFiltration
import Mathlib.MeasureTheory.Measure.Trim
import Mathlib.MeasureTheory.Measure.Typeclasses.Finite

/-!
# Positive-time predictable rectangles

We use the sigma algebra generated by past events times `(s,t]` times
measurable bounded-height categories, with `s ≥ 0`. The finite-height
restriction does not exclude any measurable mark category: an increasing
union removes it. Time zero is intentionally excluded from the generators;
the constructed marked counting measure and its intensity have no atom there.

The finite-measure uniqueness lemma is the monotone-class step used to
compare the actual Campbell measure with the deterministic product measure
after restriction to a finite time-height box.
-/

noncomputable section
open MeasureTheory Set MeasurableSpace

namespace CarryingCapacity.PredictableSets

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

def rectangle (A : Set Ω) (s t : ℝ) (B : Set ℝ) : Set (Ω × (ℝ × ℝ)) :=
  A ×ˢ (Ioc s t ×ˢ B)

def rectangles (F : Filtration ℝ mΩ) : Set (Set (Ω × (ℝ × ℝ))) :=
  {S | ∃ (s t : ℝ) (A : Set Ω) (B : Set ℝ) (m : ℕ),
    0 ≤ s ∧ MeasurableSet[F s] A ∧ MeasurableSet B ∧
      B ⊆ Iio (m : ℝ) ∧ S = rectangle A s t B}

def predictable (F : Filtration ℝ mΩ) : MeasurableSpace (Ω × (ℝ × ℝ)) :=
  generateFrom (rectangles F)

theorem measurableSet_rectangle (F : Filtration ℝ mΩ)
    (s t : ℝ) (A : Set Ω) (B : Set ℝ)
    (hA : MeasurableSet[F s] A) (hB : MeasurableSet B) :
    MeasurableSet (rectangle A s t B) :=
  (F.le s _ hA).prod (measurableSet_Ioc.prod hB)

theorem predictable_le (F : Filtration ℝ mΩ) :
    predictable F ≤ (inferInstance : MeasurableSpace (Ω × (ℝ × ℝ))) := by
  apply generateFrom_le
  rintro S ⟨s, t, A, B, m, _, hA, hB, _, rfl⟩
  exact measurableSet_rectangle F s t A B hA hB

omit mΩ in
theorem rectangle_inter (A D : Set Ω) (s t u v : ℝ) (B C : Set ℝ) :
    rectangle A s t B ∩ rectangle D u v C =
      rectangle (A ∩ D) (max s u) (min t v) (B ∩ C) := by
  simp only [rectangle, prod_inter_prod, Ioc_inter_Ioc]

theorem isPiSystem_rectangles (F : Filtration ℝ mΩ) : IsPiSystem (rectangles F) := by
  rintro S ⟨s, t, A, B, m, hs, hA, hB, hb, rfl⟩
    T ⟨u, v, D, C, n, hu, hD, hC, hc, rfl⟩ _
  refine ⟨max s u, min t v, A ∩ D, B ∩ C, m, hs.trans (le_max_left _ _),
    ?_, hB.inter hC, ?_, rectangle_inter A D s t u v B C⟩
  · exact ((F.mono (le_max_left s u)) _ hA).inter
      ((F.mono (le_max_right s u)) _ hD)
  · exact inter_subset_left.trans hb

theorem measurableSet_predictable_rectangle_bounded (F : Filtration ℝ mΩ)
    (s t : ℝ) (hs : 0 ≤ s) (A : Set Ω) (hA : MeasurableSet[F s] A)
    (B : Set ℝ) (hB : MeasurableSet B) (m : ℕ) (hb : B ⊆ Iio (m : ℝ)) :
    MeasurableSet[predictable F] (rectangle A s t B) :=
  measurableSet_generateFrom ⟨s, t, A, B, m, hs, hA, hB, hb, rfl⟩

/-- Every measurable mark category is obtained by removing the height cutoff. -/
theorem measurableSet_predictable_rectangle (F : Filtration ℝ mΩ)
    (s t : ℝ) (hs : 0 ≤ s) (A : Set Ω) (hA : MeasurableSet[F s] A)
    (B : Set ℝ) (hB : MeasurableSet B) :
    MeasurableSet[predictable F] (rectangle A s t B) := by
  have he : rectangle A s t B = ⋃ n : ℕ, rectangle A s t (B ∩ Iio (n : ℝ)) := by
    ext p
    simp only [rectangle, mem_prod, mem_Ioc, mem_iInter, mem_iUnion, mem_inter_iff,
      mem_Iio]
    constructor
    · rintro ⟨hA, ht, hB⟩
      obtain ⟨n, hn⟩ := exists_nat_gt p.2.2
      exact ⟨n, hA, ht, hB, hn⟩
    · rintro ⟨n, hA, ht, hB, _⟩
      exact ⟨hA, ht, hB⟩
  rw [he]
  exact MeasurableSet.iUnion (fun n => measurableSet_predictable_rectangle_bounded
    F s t hs A hA (B ∩ Iio (n : ℝ)) (hB.inter measurableSet_Iio) n inter_subset_right)

/-- Finite measures agreeing on predictable rectangles and the whole space
agree on the full generated sigma algebra. -/
theorem trim_eq_of_rectangles (F : Filtration ℝ mΩ)
    (μ ν : Measure (Ω × (ℝ × ℝ))) [IsFiniteMeasure μ]
    (hrect : ∀ S ∈ rectangles F, μ S = ν S) (huniv : μ univ = ν univ) :
    μ.trim (predictable_le F) = ν.trim (predictable_le F) := by
  apply ext_of_generate_finite (rectangles F) rfl (isPiSystem_rectangles F)
  · intro S hS
    rw [trim_measurableSet_eq _ (measurableSet_generateFrom hS),
      trim_measurableSet_eq _ (measurableSet_generateFrom hS)]
    exact hrect S hS
  · simpa only [trim_measurableSet_eq _ MeasurableSet.univ] using huniv

end CarryingCapacity.PredictableSets
