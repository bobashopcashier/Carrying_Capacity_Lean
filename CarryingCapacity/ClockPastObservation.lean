import CarryingCapacity.NullAugmentedIndependence
import CarryingCapacity.PoissonPastIndependence
import CarryingCapacity.MarkedStripCounts

/-!
# Censored clock observations in the augmented count history

The exact censored arrival and its arrival mask are measurable in the sigma
algebra generated by past proposal counts, augmented by null sets of the actual
waiting-time law. The arrival/count identity is proved on the existing common
good-clock event. The observations retain their original exceptional values.
-/

noncomputable section
open MeasureTheory ProbabilityTheory Set Filter

namespace CarryingCapacity.ClockPastObservation
open CountableJumpProcess FrozenProcess PoissonIncrements PoissonPastIndependence
  NullAugmentedIndependence

/-- The whole past count history, augmented by the actual clock law's null sets. -/
def augmentedPast (r : ℝ) (hr : 0 < r) (s : ℝ) : MeasurableSpace ClockSpace :=
  augmentation (past s) (waitingTimeLaw r hr)

/-- An actual arrival is revealed only after it occurs. -/
def censoredArrival (s : ℝ) (k : ℕ) (ω : ClockSpace) : ℝ :=
  if arrival ω (k + 1) ≤ s then arrival ω (k + 1) else s + 1

/-- The count-observed indicator of whether proposal index `k` has arrived. -/
def countMask (s : ℝ) (k : ℕ) (ω : ClockSpace) : Bool :=
  decide (k < proposalCount ω s)

/-- The exact arrival-observed indicator, on every original sample. -/
def arrivalMask (s : ℝ) (k : ℕ) (ω : ClockSpace) : Bool :=
  decide (arrival ω (k + 1) ≤ s)

theorem measurable_censoredArrival (s : ℝ) (k : ℕ) : Measurable (censoredArrival s k) :=
  (measurable_arrival (k + 1)).ite
    (measurableSet_le (measurable_arrival (k + 1)) measurable_const) measurable_const

theorem censoredArrival_le_sentinel (s : ℝ) (k : ℕ) (ω : ClockSpace) :
    censoredArrival s k ω ≤ s + 1 := by
  unfold censoredArrival
  split_ifs with h
  · linarith
  · exact le_rfl

/-- Below the sentinel, a censored observation is tested at a time in the past. -/
theorem censoredArrival_le_iff (s x : ℝ) (hx : x < s + 1) (k : ℕ) (ω : ClockSpace) :
    censoredArrival s k ω ≤ x ↔ arrival ω (k + 1) ≤ min s x := by
  by_cases h : arrival ω (k + 1) ≤ s
  · simp only [censoredArrival, h, ↓reduceIte, le_min_iff, true_and]
  · simp only [censoredArrival, h, ↓reduceIte, le_min_iff, false_and, iff_false]
    exact not_le_of_gt hx

/-- Every nonnegative past count is measurable in the raw full count history. -/
theorem measurable_proposalCount_past (s t : ℝ) (ht : 0 ≤ t) (hts : t ≤ s) :
    Measurable[past s] (fun ω => proposalCount ω t) :=
  (comap_measurable (fun ω => proposalCount ω t)).mono
    (le_iSup_of_le (⟨t, ht, hts⟩ : PastTime s) le_rfl) le_rfl

theorem measurable_countMask (s : ℝ) (hs : 0 ≤ s) (k : ℕ) :
    Measurable[past s] (countMask s k) := by
  apply measurable_to_bool
  simpa only [countMask, Set.preimage, Set.mem_singleton_iff, decide_eq_true_eq] using
    (measurableSet_lt measurable_const (measurable_proposalCount_past s s hs le_rfl)
      : MeasurableSet[past s] {ω | k < proposalCount ω s})

/-- The actual count threshold law holds at all nonnegative times and indices
on one common event of full probability. -/
theorem ae_arrival_le_iff_count (r : ℝ) (hr : 0 < r) :
    ∀ᵐ ω ∂waitingTimeLaw r hr, ∀ t : ℝ, 0 ≤ t → ∀ k : ℕ,
      (arrival ω (k + 1) ≤ t ↔ k < proposalCount ω t) := by
  filter_upwards [ae_locally_finite r hr, ae_arrival_tendsto r hr] with ω hω hd
  exact fun t ht k => MarkedStripCounts.arrival_le_iff_lt_proposalCount hω.1 hd t ht k

theorem ae_arrivalMask_eq_countMask (r : ℝ) (hr : 0 < r) (s : ℝ) (hs : 0 ≤ s) :
    ∀ᵐ ω ∂waitingTimeLaw r hr, ∀ k : ℕ, arrivalMask s k ω = countMask s k ω := by
  filter_upwards [ae_arrival_le_iff_count r hr] with ω hω
  intro k
  simp only [arrivalMask, countMask, hω s hs k]

/-- Completion handles the actual arrival mask without changing exceptional samples. -/
theorem measurable_arrivalMask_augmentedPast (r : ℝ) (hr : 0 < r)
    (s : ℝ) (hs : 0 ≤ s) (k : ℕ) :
    Measurable[augmentedPast r hr s] (arrivalMask s k) := by
  apply (measurable_countMask s hs k).eventuallyMeasurable_of_eventuallyEq
  filter_upwards [ae_arrivalMask_eq_countMask r hr s hs] with ω hω
  exact hω k

theorem measurableSet_arrived_augmentedPast (r : ℝ) (hr : 0 < r)
    (s : ℝ) (hs : 0 ≤ s) (k : ℕ) :
    MeasurableSet[augmentedPast r hr s] {ω | arrival ω (k + 1) ≤ s} := by
  have h := (measurable_arrivalMask_augmentedPast r hr s hs k)
    (measurableSet_singleton true)
  simpa only [arrivalMask, Set.preimage, Set.mem_singleton_iff, decide_eq_true_eq] using h

/-- The exact censored arrival time is measurable in the null-augmented past,
proved from count threshold events rather than an assumed observation law. -/
theorem measurable_censoredArrival_augmentedPast (r : ℝ) (hr : 0 < r)
    (s : ℝ) (hs : 0 ≤ s) (k : ℕ) :
    Measurable[augmentedPast r hr s] (censoredArrival s k) := by
  apply measurable_of_Iic
  intro x
  by_cases hsent : s + 1 ≤ x
  · have he : censoredArrival s k ⁻¹' Iic x = univ := by
      ext ω
      simp only [Set.mem_preimage, Set.mem_Iic, Set.mem_univ, iff_true]
      exact (censoredArrival_le_sentinel s k ω).trans hsent
    rw [he]
    exact MeasurableSet.univ
  · by_cases hx : 0 ≤ x
    · refine ⟨{ω | k < proposalCount ω (min s x)}, ?_, ?_⟩
      · exact measurableSet_lt measurable_const
          (measurable_proposalCount_past s (min s x) (le_min hs hx) (min_le_left _ _))
      · filter_upwards [ae_arrival_le_iff_count r hr] with ω hω
        apply propext
        exact (censoredArrival_le_iff s x (lt_of_not_ge hsent) k ω).trans
          (hω (min s x) (le_min hs hx) k)
    · refine ⟨∅, @MeasurableSet.empty _ (past s), ?_⟩
      filter_upwards [ae_locally_finite r hr] with ω hω
      have hp : 0 < arrival ω (k + 1) := by
        simpa only [arrival_zero] using hω.1 (Nat.zero_lt_succ k)
      have hc : 0 ≤ censoredArrival s k ω := by
        unfold censoredArrival
        split_ifs
        · exact hp.le
        · linarith
      change (censoredArrival s k ω ≤ x) = False
      apply propext
      constructor
      · intro h
        exact hx (hc.trans h)
      · exact False.elim

/-- The proved clock-past independence remains true for the augmented history. -/
theorem independent_augmentedPast_increment (r : ℝ) (hr : 0 < r)
    (s t : ℝ) (hs : 0 ≤ s) (ht : 0 ≤ t) :
    Indep (augmentedPast r hr s)
      (MeasurableSpace.comap (fun ω => increment ω s t) inferInstance)
      (waitingTimeLaw r hr) :=
  indep_augment_left (independent_past_increment r hr s t hs ht)

/-- Any measurable function of the augmented clock past is independent of the
next count increment. In particular this applies to finite censored-cylinder means. -/
theorem independent_function_increment {A : Type*} [MeasurableSpace A]
    (r : ℝ) (hr : 0 < r) (s t : ℝ) (hs : 0 ≤ s) (ht : 0 ≤ t)
    (f : ClockSpace → A) (hf : Measurable[augmentedPast r hr s] f) :
    IndepFun f (fun ω => increment ω s t) (waitingTimeLaw r hr) := by
  change Indep _ _ _
  exact indep_of_indep_of_le_left
    (independent_augmentedPast_increment r hr s t hs ht) hf.comap_le

end CarryingCapacity.ClockPastObservation
