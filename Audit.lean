import CarryingCapacity
import Lean.Util.CollectAxioms
import Lean.Elab.Command

/-!
# Exhaustive project proof audit

Run with `lake env lean Audit.lean`. This inspects the compiled environment,
including private and compiler-generated declarations from every imported
`CarryingCapacity` module. It rejects local axioms and checks every safe declaration's transitive axiom
dependencies. Compiler-generated unsafe runtime specializations are not proofs;
the source checker separately forbids handwritten unsafe declarations. The source-check
script additionally ensures that the root import includes every project module.
-/

open Lean Elab Command

run_cmd do
  let env ← getEnv
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut declarationCount := 0
  let mut theoremCount := 0
  let mut modules : Array Name := #[]
  -- A completed traversal certifies all visited dependencies. Reusing the state
  -- avoids expanding shared library proofs once for every project declaration.
  -- Only newly discovered axioms need checking; the outer loop still checks and
  -- counts every safe declaration, even when a previous root already visited it.
  let mut collected : Lean.CollectAxioms.State := {}
  for (name, info) in env.constants.toList do
    let some index := env.getModuleIdxFor? name | continue
    let moduleName := env.header.moduleNames[index.toNat]!
    unless (`CarryingCapacity).isPrefixOf moduleName do continue
    unless modules.contains moduleName do modules := modules.push moduleName
    -- Native-code specializations generated by Lean are unsafe runtime code,
    -- never theorem proofs. Handwritten unsafe declarations are source-rejected.
    if info.isUnsafe then continue
    if info.isAxiom then throwError "Project axiom is forbidden: {name}"
    let previousAxiomCount := collected.axioms.size
    let (_, next) := ((Lean.CollectAxioms.collect name).run env).run collected
    collected := next
    for i in [previousAxiomCount:collected.axioms.size] do
      let dependency := collected.axioms[i]!
      unless allowed.contains dependency do
        throwError "{name} depends on forbidden axiom {dependency}"
    declarationCount := declarationCount + 1
    if info.isTheorem then theoremCount := theoremCount + 1
  if theoremCount == 0 then throwError "No project theorems were audited"
  logInfo m!"Proof audit passed: {theoremCount} theorems, {declarationCount} safe declarations, \
    {modules.size} modules. Permitted axioms: propext, Classical.choice, Quot.sound."
